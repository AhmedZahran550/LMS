<!DOCTYPE html>
<html>
<head>
    <title>You've been invited!</title>
</head>
<body>
    <h1>You've been invited to join {{instructorName}}'s courses</h1>
    <p>{{instructorName}} has invited you to join their courses on {{appName}}.</p>
    <p>To accept this invitation, download the {{appName}} app and open the link on your phone.</p>
    <p><a href="{{acceptUrl}}" style="display: inline-block; padding: 12px 24px; background-color: #4f46e5; color: white; text-decoration: none; border-radius: 6px;">View Invitation</a></p>
    <hr style="margin-top: 32px; border: none; border-top: 1px solid #e5e7eb;" />
    <p style="color: #6b7280; font-size: 12px; text-align: center;">{{appName}}</p>
</body>
</html>
