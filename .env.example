# Database
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_db
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_SECRET=your-access-secret-please-change-in-prod
JWT_REFRESH_SECRET=your-refresh-secret-please-change-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Mail Provider: 'smtp' or 'resend'
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@lms.com

# SMTP (Development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (Production)
RESEND_API_KEY=

# Storage (Direct-to-Cloud only — Cloudinary)
STORAGE_PROVIDER=cloudinary
MAX_FILE_SIZE=524288000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Seed
ADMIN_EMAIL=admin@lms.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# API
API_PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
